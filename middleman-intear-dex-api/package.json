{
  "name": "@sleet-js/middleman-intear-dex-api",
  "version": "0.1.0",
  "description": "Clean TypeScript middleman for the Intear DEX backend API (https://dex-backend.intear.tech).",
  "license": "MIT",
  "homepage": "https://sleet-js.near.page",
  "repository": {
    "type": "git",
    "url": "https://github.com/sleet-js/middleman.git",
    "directory": "middleman-intear-dex-api"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist/**/*",
    "bin/**/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -f .tsbuildinfo && bun run tsc --build tsconfig.build.json --force",
    "clean": "bun run tsc --build --clean && rm -rf dist .tsbuildinfo",
    "tsc": "tsc"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
